# Database configuration (PostgreSQL)
ENV_PROTUBE_DB_HOST=db
ENV_PROTUBE_DB=protube
ENV_PROTUBE_DB_USER=root
ENV_PROTUBE_DB_PASS=pwd

# Video storage directory
# In Docker Compose, this is the host path mounted into the container (/videos/)
# For local development outside Docker, set this to your absolute video directory path ending with a slash
ENV_PROTUBE_STORE_DIR=./videos/

# Google OAuth2 credentials
ENV_PROTUBE_GOOGLE_CLIENT_ID=dummy-client-id
ENV_PROTUBE_GOOGLE_CLIENT_SECRET=dummy-client-secret
